-- Helper: Tween Function
local function tween(object, info, properties)
    return TweenService:Create(object, info, properties)
end

-- Startup Fade-In Animation
local fadeInInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

tween(MainFrame, fadeInInfo, {BackgroundTransparency = 0.05}):Play()
tween(MainStroke, fadeInInfo, {Transparency = 0.3}):Play()
tween(TitleLabel, fadeInInfo, {TextTransparency = 0}):Play()
tween(SubtitleLabel, fadeInInfo, {TextTransparency = 0}):Play()
tween(StatusLabel, fadeInInfo, {TextTransparency = 0}):Play()
tween(PercentLabel, fadeInInfo, {TextTransparency = 0}):Play()
tween(ProgressBG, fadeInInfo, {BackgroundTransparency = 0}):Play()

task.wait(0.6)

-- Loading Sequences
local stages = {
    {status = "Creating hub...", progress = 0.25, time = 0.7},
    {status = "Bypassing security checks...", progress = 0.55, time = 0.9},
    {status = "Fetching hub modules...", progress = 0.85, time = 0.8},
    {status = "Initializing interface...", progress = 1.0, time = 0.5}
}

for _, stage in ipairs(stages) do
    StatusLabel.Text = stage.status
    
    local barTween = tween(ProgressFill, TweenInfo.new(stage.time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(stage.progress, 0, 1, 0)
    })
    barTween:Play()

    -- Smoothly update percentage text
    local startVal = tonumber(PercentLabel.Text:match("%d+")) or 0
    local targetVal = math.floor(stage.progress * 100)
    
    task.spawn(function()
        for i = startVal, targetVal do
            PercentLabel.Text = i .. "%"
            task.wait(stage.time / (targetVal - startVal + 1))
        end
    end)

    task.wait(stage.time + 0.1)
end

StatusLabel.Text = "Loaded Successfully!"
StatusLabel.TextColor3 = Color3.fromRGB(120, 230, 160)
PercentLabel.TextColor3 = Color3.fromRGB(120, 230, 160)

task.wait(0.6)

-- Outro Animation
local fadeOutInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

tween(MainFrame, fadeOutInfo, {
    Size = UDim2.new(0, 380, 0, 0),
    BackgroundTransparency = 1
}):Play()

tween(MainStroke, fadeOutInfo, {Transparency = 1}):Play()
tween(TitleLabel, fadeOutInfo, {TextTransparency = 1}):Play()
tween(SubtitleLabel, fadeOutInfo, {TextTransparency = 1}):Play()
tween(StatusLabel, fadeOutInfo, {TextTransparency = 1}):Play()
tween(PercentLabel, fadeOutInfo, {TextTransparency = 1}):Play()
tween(ProgressBG, fadeOutInfo, {BackgroundTransparency = 1}):Play()

task.wait(0.5)

